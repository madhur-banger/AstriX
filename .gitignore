# Ignore node_modules
node_modules/

# Ignore logs
npm-debug.log
yarn-debug.log
yarn-error.log

# Ignore environment files
.env
.env.local

data.txt

# Ignore build artifacts or any compiled files (if you use TypeScript or other compilers)
build/
dist/
coverage/

.terraform/
infra/environments/dev/.terraform/

# Terraform
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
*.tfvars
# `*.tfvars` does NOT match `terraform.tfvars.backup.20240101_120000` - the
# timestamped copies setup-https.sh writes are full plaintext secrets, so both
# the backup directory and the legacy naming pattern are ignored explicitly.
.tfvars-backups/
*.tfvars.backup.*

# Certs/keys generated by the acm module's local_file resources - these
# must never be committed (see infra/PLAN.md §1.1)
infra/certificates/*.pem
*.pem
*.key
