# Required. No default - the server will refuse to start without it.
PORT=8000
NODE_ENV=development

# Required. No default.
MONGO_URI=""

# Optional. Defaults to "/api" if unset.
BASE_PATH=/api

# Optional. The externally-reachable API URL shown in /api/docs. Defaults to
# a localhost guess; set explicitly in any hosted environment (behind an
# ALB/CloudFront, this isn't the port Express binds to).
API_PUBLIC_URL=http://localhost:8000/api

# ============================================
# JWT (required - no defaults for secrets)
# ============================================
JWT_ACCESS_TOKEN_SECRET="replace_with_a_long_random_access_token_secret"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"

JWT_REFRESH_TOKEN_SECRET="replace_with_a_long_random_refresh_token_secret"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# Optional. Sets the Domain attribute on the refresh-token cookie
# (e.g. ".example.com"). Leave unset for host-only cookies in local dev.
COOKIE_DOMAIN=

# Optional. Defaults to "30m" if unset.
PASSWORD_RESET_TOKEN_EXPIRES_IN="30m"

# Optional. Defaults to "24h" if unset. Email verification is advisory only
# (see PLAN.md §3) - it never blocks login, so a longer-lived link is fine.
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="24h"

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# ============================================
# Frontend
# ============================================
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_GOOGLE_CALLBACK_URL=http://localhost:5173/google/callback
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password
FRONTEND_EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email

# ============================================
# Email (Resend) - optional. If RESEND_API_KEY is unset, password reset
# emails are logged to the console instead of sent, so local dev works
# without a Resend account.
# ============================================
RESEND_API_KEY=
EMAIL_FROM="onboarding@resend.dev"
